# Splunk REST (port 8089) — standard token, NOT the encrypted MCP token
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_TOKEN=<your-symphunk-rest-token>
SPLUNK_PASSWORD=<your-splunk-admin-password>

# MCP Server — encrypted token, MCP-only (will 401 against REST 8089)
# Use HTTP endpoint for local dev (no SSL cert issues)
MCP_URL=http://localhost:8000/en-US/splunkd/__raw/services/mcp
MCP_TOKEN=<your-encrypted-mcp-token>

# HEC (port 8088) — symphunk-hec token
HEC_URL=http://localhost:8088
HEC_TOKEN=<your-hec-token>

# Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-4-6

# Orchestrator
MAX_CONCURRENT_AGENTS=3
POLL_INTERVAL_SECONDS=30
MAX_SEARCHES_PER_RUN=10
